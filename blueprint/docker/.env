VERSION='0.0.alpha1'
NAME=bottle-filling-digital-twin
PUBLIC_IPV4="127.0.0.1" # eg., 192.168.165.122
PUBLIC_IPV4_SUBNET="127.0.0.0.0/24" # just remove the last octet and put .0/24 eg., 192.168.165.0/24

# Fluent Configuration
FLUENT_PORT=40007

# Kit app configuration
VISCOSITY = "0.002"
BOTTLES_PER_HOUR = "50000"
FILLING_HEIGHT = "28"
TIMESTEP_SIZE = "0.001"
BOTTLE_UNITS_1 = "48.0"
BOTTLE_UNITS_2 = "36.0"
BOTTLE_UNITS_3 = "24.0"
FIRST_ITERATION_TIMESTEPS = "500"
CONTENT_PATH = "/app/content/"

# Ansys License Configuration
ANSYSLMD_LICENSE_FILE="1055@10.2.0.10" # replace this with 1055@<your-license-server-vm-internal-ip> on cloud VMs.

### UI ENV
NODE_ENV=production
UI_CONTAINER_IMAGE=ansys/bottle-filling-ui:latest # Latest is 0.0.aplha1 at the time of writing
UI_PORT=3001
UI_HOST=localhost
UI_URL=http://${UI_HOST}:${UI_PORT}
UI_RELATIVE_PATH=/
